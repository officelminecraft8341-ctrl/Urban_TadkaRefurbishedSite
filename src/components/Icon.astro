};

const {
  name,
  size = 20,
  stroke = 1.75,
  label,
  class: className = '',
} = Astro.props;

const raw: string | undefined = PATHS[name];

if (!raw) {
  throw new Error(
    `Icon "${name}" does not exist. Available: ${Object.keys(PATHS).join(', ')}`,
  );
}

const paths: string[] = raw.split('|');
---

<svg
  class={`icon ${className}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  data-icon={name}
>
  {label && <title>{label}</title>}
  {paths.map((d) => <path d={d} />)}
</svg>

<style>
  .icon {
    display: inline-block;
    vertical-align: middle;
    flex: none;
  }
</style>
