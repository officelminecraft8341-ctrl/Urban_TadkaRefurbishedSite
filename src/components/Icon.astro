---
/**
 * Icon — a small, hand-authored stroke icon set.
 *
 * Deliberately dependency-free: no icon library is installed, so there is no
 * third-party licence to track and no unused code shipped. Every path is
 * original artwork drawn on a 24x24 grid with a 1.75 stroke.
 *
 * Each icon is ONE <svg> containing one or more <path> elements (the source
 * strings are pipe-separated). Icons are decorative by default because they
 * always sit beside a text label; pass `label` only for a genuinely icon-only
 * control, which then gets role="img" and an accessible name.
 */

interface Props {
  /** Key into the icon set below. Throws at build time if it does not exist. */
  name: string;
  size?: number;
  stroke?: number;
  /** Only for a genuinely icon-only control; otherwise leave unset. */
  label?: string;
  class?: string;
}

const PATHS: Record<string, string> = {
