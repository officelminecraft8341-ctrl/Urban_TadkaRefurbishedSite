---
/**
 * PhotoPlaceholder
 *
 * Same finished-looking art panel in the site's own visual language — deep
 * spice-toned gradients with a thali-ring motif, drawn entirely in CSS — but
 * the middle of the panel now names the photograph it is holding the place
 * for. Beta reviewers see exactly which shot goes where without opening a
 * separate notes page; diners see an honest "photo needed" card, never a
 * fake photograph or a dish it does not show.
 *
 * `title` is the shot needed, e.g. "Biryani handi, lid opened at table".
 * Every position on the site passes one. Omitting it renders pure art
 * (decorative, aria-hidden). Dropping in real photography later means
 * replacing this component with an <img> at the same position.
 */

interface Props {
  /** Which photograph belongs here. Always pass one on the site. */
  title?: string;
  /** Any key of RATIOS; anything else falls back to 4/3. */
  ratio?: string;
  tone?: 'warm' | 'night';
  compact?: boolean;
  class?: string;
}

const {
  title,
  ratio = '4/3',
  tone = 'warm',
  compact = false,
  class: className = '',
} = Astro.props;

const RATIOS: Record<string, string> = {
  '16/9': '16 / 9',
  '3/2': '3 / 2',
  '4/3': '4 / 3',
  '1/1': '1 / 1',
  '4/5': '4 / 5',
  '3/4': '3 / 4',
};

const ratioValue = RATIOS[ratio] ?? RATIOS['4/3'];
---

<figure
  class={`photo photo--${tone} ${compact ? 'photo--compact' : ''} ${className}`.trim()}
  aria-hidden={title ? undefined : 'true'}
>
  <div class="photo__art" style={`--ratio: ${ratioValue}`}>
    {
      title && (
        <span class="photo__label">
          <span class="photo__eyebrow">Photo needed</span>
          <span class="photo__title">{title}</span>
        </span>
      )
    }
  </div>
</figure>

<style>
  .photo {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .photo__art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: var(--ratio);
    width: 100%;
    overflow: hidden;
    border-radius: var(--r-md);
    border: 1px solid rgba(255, 204, 41, 0.28);
    background:
      radial-gradient(circle at 50% 28%, rgba(255, 204, 41, 0.24), transparent 46%),
      repeating-radial-gradient(
        circle at 50% 42%,
        rgba(255, 204, 41, 0.1) 0 2px,
        transparent 2px 16px
      ),
      linear-gradient(155deg, #54282c 0%, #33201f 48%, #1c1917 100%);
  }

  /* A single crisp ring: the rim of a thali seen from above. */
  .photo__art::before {
    content: "";
    position: absolute;
    top: 7%;
    left: 50%;
    width: 46%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border: 1px solid rgba(255, 204, 41, 0.32);
    border-radius: 50%;
  }

  /* Vignette, so the panel reads as a finished image area. */
  .photo__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 95% at 50% 40%, transparent 55%, rgba(0, 0, 0, 0.4));
  }

  .photo--warm .photo__art {
    background:
      radial-gradient(circle at 50% 28%, rgba(255, 204, 41, 0.3), transparent 46%),
      repeating-radial-gradient(
        circle at 50% 42%,
        rgba(255, 204, 41, 0.12) 0 2px,
        transparent 2px 16px
      ),
      linear-gradient(155deg, #6b3a1e 0%, #422716 48%, #241a12 100%);
  }

  .photo__label {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    max-width: 92%;
    margin: 0;
    padding: 0.65rem 1rem;
    border: 1px solid rgba(255, 204, 41, 0.35);
    border-radius: var(--r-sm);
    background: rgba(20, 17, 15, 0.66);
    text-align: center;
  }

  .photo__eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-gold, #ffcc29);
  }

  .photo__title {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #fbf8f3;
    text-wrap: balance;
  }

  .photo--compact .photo__art::before {
    width: 40%;
  }

  .photo--compact .photo__label {
    padding: 0.55rem 0.85rem;
  }
</style>
