---
/**
 * GalleryGrid
 *
 * Twelve art tiles standing in for photographs that will be shot in the
 * restaurant. Each tile names its shot in the middle of the panel, so beta
 * reviewers see the shot list where the photographs will sit.
 *
 * The viewer is a native <dialog>: focus trapping, Esc-to-close and inert
 * background content come from the platform. Keyboard: every tile is a real
 * <button>; inside the viewer, Left/Right move between tiles, Esc closes, and
 * focus returns to the tile that opened it.
 *
 * All slides render server-side. Dropping in real photography later means
 * replacing the PhotoPlaceholder inside each slide with an <img> carrying a
 * factual alt text — the viewer logic does not change.
 */

import PhotoPlaceholder from './PhotoPlaceholder.astro';
import Icon from './Icon.astro';

interface Props {
  /** How many tiles the grid holds. */
  count: number;
  /** Base for the dialog id, so two galleries can coexist on one page. */
  id?: string;
}

/**
 * The twelve shots, in the same order as the owner-review checklist. The same
 * label drives the grid tile and its lightbox slide, so the two can never
 * disagree about which photograph goes where.
 */
const SHOTS = [
  'Dining room, wide, dinner service',
  'Exterior on Market Place Blvd, daytime',
  'Chef lifting naan from the tandoor',
  'Biryani in its handi, lid opened at table',
  'Table with three curries, rice, naan basket',
  'Samosas with chutney, close-up',
  'Tandoori platter arriving at table',
  'Whole spices in steel bowl, close-up',
  'Lassi in a tall glass',
  'Gulab jamun in syrup, two pieces',
  'Full table of dishes, overhead',
  'Counter and pickup area, staffed',
];

const { count, id = 'gallery' } = Astro.props;
const dialogId = `${id}-dialog`;
const tiles = Array.from({ length: count }, (_, index) => ({
  index,
  shot: SHOTS[index] ?? `Photo ${index + 1}`,
}));
---

<ul class="gallery" data-gallery>
  {
    tiles.map((tile) => (
      <li class="gallery__item">
        <button
          type="button"
          class="gallery__trigger"
          data-gallery-open={tile.index}
          aria-label={`Photo needed, ${tile.shot}, photo ${tile.index + 1} of ${count}`}
        >
          <PhotoPlaceholder ratio="4/3" compact title={tile.shot} />
          <span class="gallery__hint" aria-hidden="true">
            {tile.index + 1} / {count}
          </span>
        </button>
      </li>
    ))
  }
</ul>

<dialog id={dialogId} class="lightbox" data-gallery-dialog aria-label="Gallery viewer">
  <div class="lightbox__bar">
    <p class="lightbox__counter" data-gallery-counter aria-live="polite"></p>
    <button type="button" class="lightbox__close" data-gallery-close>
      Close
      <Icon name="close" size={18} />
    </button>
  </div>

  <div class="lightbox__stage">
    {
      tiles.map((tile) => (
        <div
          class="lightbox__slide"
          data-gallery-slide={tile.index}
          hidden={tile.index !== 0}
        >
          <PhotoPlaceholder ratio="3/2" tone="night" title={tile.shot} />
        </div>
      ))
    }
  </div>

  <div class="lightbox__nav">
    <button type="button" class="lightbox__button" data-gallery-prev>
      <Icon name="arrowRight" size={18} class="flip" />
      Previous
    </button>
    <button type="button" class="lightbox__button" data-gallery-next>
      Next
      <Icon name="arrowRight" size={18} />
    </button>
  </div>
</dialog>

<style>
  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 34rem) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-5);
    }
  }

  .gallery__item {
    margin: 0;
  }

  .gallery__trigger {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border-radius: var(--r-md);
    text-align: left;
    transition: transform var(--dur) var(--ease);
  }

  @media (hover: hover) {
    .gallery__trigger:hover {
      transform: translateY(-3px);
    }
  }

  .gallery__hint {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    padding: 0.2rem 0.55rem;
    border-radius: var(--r-xs);
    background: var(--night);
    color: var(--paper);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  /* --- lightbox --------------------------------------------------------- */
  .lightbox {
    width: min(60rem, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    padding: var(--sp-4);
    border: 1px solid rgba(251, 248, 243, 0.16);
    border-radius: var(--r-lg);
    background: var(--night);
    color: var(--ink-invert);
  }

  .lightbox::backdrop {
    background: rgba(15, 13, 12, 0.78);
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  .lightbox__counter {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--brand-gold);
  }

  .lightbox__close,
  .lightbox__button {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    /* 50% over the night surface measures ~4.9:1 - comfortably past the 3:1 a
       control boundary needs, unlike the 35% it started at (~2.6:1). */
    border: 1.5px solid rgba(251, 248, 243, 0.5);
    border-radius: var(--r-sm);
    color: var(--ink-invert);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .lightbox__close:hover,
  .lightbox__button:hover {
    background: rgba(251, 248, 243, 0.12);
    border-color: var(--ink-invert);
  }

  .lightbox__stage {
    display: grid;
  }

  .lightbox__nav {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }

  .lightbox__nav :global(.flip) {
    transform: rotate(180deg);
  }

  @media (max-width: 33.99rem) {
    .lightbox {
      padding: var(--sp-3);
    }
  }
</style>

<script>
  /**
   * Lightbox behaviour. Written as a single delegated controller so multiple
   * galleries on one page keep working, and so it degrades safely: if the
   * <dialog> API is unavailable, tiles simply stay static and no broken UI
   * appears.
   */
  type Gallery = {
    root: HTMLElement;
    dialog: HTMLDialogElement;
    slides: HTMLElement[];
    counter: HTMLElement | null;
    openers: HTMLButtonElement[];
    index: number;
    lastFocus: HTMLElement | null;
  };

  const galleries: Gallery[] = [];

  function setup(root: HTMLElement) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const openers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gallery-open]'));
    const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');

    if (!dialog || typeof dialog.showModal !== 'function' || slides.length === 0) return;

    galleries.push({ root, dialog, slides, counter, openers, index: 0, lastFocus: null });
  }

  function show(gallery: Gallery, nextIndex: number) {
    const total = gallery.slides.length;
    gallery.index = (nextIndex + total) % total;

    gallery.slides.forEach((slide, i) => {
      slide.hidden = i !== gallery.index;
    });

    if (gallery.counter) {
      gallery.counter.textContent = `Photo ${gallery.index + 1} of ${total}`;
    }
  }

  function open(gallery: Gallery, index: number, trigger: HTMLElement | null) {
    gallery.lastFocus = trigger;
    show(gallery, index);
    gallery.dialog.showModal();
    gallery.dialog.querySelector<HTMLButtonElement>('[data-gallery-close]')?.focus();
  }

  function close(gallery: Gallery) {
    gallery.dialog.close();
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(setup);

  galleries.forEach((gallery) => {
    gallery.openers.forEach((opener) => {
      opener.addEventListener('click', () => {
        open(gallery, Number(opener.dataset.galleryOpen ?? 0), opener);
      });
    });

    gallery.dialog
      .querySelector('[data-gallery-close]')
      ?.addEventListener('click', () => close(gallery));

    gallery.dialog
      .querySelector('[data-gallery-prev]')
      ?.addEventListener('click', () => show(gallery, gallery.index - 1));

    gallery.dialog
      .querySelector('[data-gallery-next]')
      ?.addEventListener('click', () => show(gallery, gallery.index + 1));

    // Native <dialog> fires 'cancel' for Esc; keep state consistent and restore focus.
    gallery.dialog.addEventListener('close', () => {
      gallery.lastFocus?.focus();
    });

    gallery.dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(gallery, gallery.index + 1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(gallery, gallery.index - 1);
      }
    });

    // Clicking the backdrop (outside the dialog box) closes the viewer.
    gallery.dialog.addEventListener('click', (event) => {
      if (event.target === gallery.dialog) close(gallery);
    });
  });
</script>
