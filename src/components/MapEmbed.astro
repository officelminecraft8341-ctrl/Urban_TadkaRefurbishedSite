---
/**
 * MapEmbed — auto-loading
 *
 * The Google Maps iframe loads with the page (deferred with loading="lazy"
 * so it does not block first paint). This is a deliberate trade-off made at
 * the developer's request: visitors see the map immediately, but Google
 * receives a third-party request on page load and may set cookies. That is
 * disclosed in plain language under the map and in full on /privacy/
 * ("Embedded map"). A click-to-load variant would avoid the on-load request;
 * it can be restored if the owner prefers.
 */

import { mapEmbedUrl, directionsUrl, siteConfig } from '../config/site.js';

const { business } = siteConfig;
---

<div class="map">
  <iframe
    src={mapEmbedUrl}
    title={`Map showing the location of ${business.legalName}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>

  <div class="map__meta">
    <p class="map__address">
      {business.streetAddress}
      <br />
      {business.addressLocality}, {business.addressRegion} {business.postalCode}
    </p>
    <p class="map__privacy">
      The map loads automatically from Google, which may set cookies.
      <a href="/privacy/">How this demo handles data</a>
    </p>
    <p class="map__fallback">
      <a href={directionsUrl} target="_blank" rel="noopener noreferrer">
        Open in Google Maps
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </p>
  </div>
</div>

<style>
  .map {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--paper-warm);
    overflow: hidden;
  }

  .map iframe {
    display: block;
    width: 100%;
    height: 20rem;
    border: 0;
  }

  @media (min-width: 48rem) {
    .map iframe {
      height: 26rem;
    }
  }

  .map__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-5);
    text-align: center;
    border-top: 1px solid var(--line);
  }

  .map__address {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    line-height: 1.4;
  }

  .map__privacy {
    max-width: 52ch;
    font-size: var(--fs-xs);
    color: var(--ink-soft);
  }

  .map__privacy a {
    color: var(--cta);
    font-weight: 600;
  }

  .map__fallback {
    font-size: var(--fs-sm);
  }
</style>
