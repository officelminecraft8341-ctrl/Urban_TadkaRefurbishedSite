---
import MainLayout from '../layouts/MainLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Button from '../components/Button.astro';
import { directionsUrl, telHref } from '../config/site.js';

/**
 * Twelve tiles stand in for photographs to be shot in the restaurant. Each
 * tile names its shot in the middle of the panel, so the shot list lives
 * where the photographs will sit.
 */
const tileCount = 12;
---

<MainLayout
  title="Gallery"
  description="Photographs of Urban Tadka — the dining room, the tandoor and the food. Awaiting authorised photography from the restaurant."
  canonicalPath="/gallery/"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h1>The room and the food</h1>
      <p class="gallery-lede">
        The dining room, the tandoor and the food. Photography for this page is
        being arranged with the restaurant — each panel below names the shot it
        is waiting for.
      </p>
    </div>
  </section>

  <section class="section section--flushtop" aria-labelledby="gallery-grid-heading">
    <div class="container">
      <h2 id="gallery-grid-heading" class="visually-hidden">Photographs</h2>
      <div id="live-gallery" hidden></div>
      <GalleryGrid count={tileCount} id="main-gallery" />
    </div>
  </section>

  <section class="section section--night">
    <div class="container gallery-cta">
      <div>
        <h2>See it in person</h2>
        <p class="gallery-cta__lede">The food reads better than any photograph of it.</p>
      </div>
      <div class="btn-row">
        <Button href="/menu/" variant="on-night" size="lg" iconAfter="arrowRight">
          View the menu
        </Button>
        <Button href={directionsUrl} variant="outline-night" size="lg" icon="navigation" external>
          Directions
        </Button>
        <Button href={telHref} variant="outline-night" size="lg" icon="phone">
          Call
        </Button>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .gallery-lede {
    margin-top: var(--sp-4);
    max-width: var(--measure);
    font-size: var(--fs-lg);
    color: var(--ink-2);
  }

  .gallery-cta {
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .gallery-cta {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .gallery-cta__lede {
    margin-top: var(--sp-2);
    color: #ded7cc;
  }

  #live-gallery {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    margin-bottom: var(--sp-6);
  }

  #live-gallery figure {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--paper);
  }

  #live-gallery img {
    width: 100%;
    height: auto;
    display: block;
  }

  #live-gallery figcaption {
    padding: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
</style>

<script>
  /**
   * Live gallery overlay. Placeholders render at build time; photos the
   * admin publishes via /api/admin/upload appear here instantly via
   * /api/gallery. All text via textContent, images via src only.
   */
  (async () => {
    try {
      const res = await fetch('/api/gallery', { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      const data = await res.json();
      if (!data || data.live !== true || !Array.isArray(data.images) || data.images.length === 0) return;
      const box = document.getElementById('live-gallery');
      if (!box) return;
      box.textContent = '';
      box.hidden = false;
      for (const g of data.images) {
        if (!g || typeof g.url !== 'string' || typeof g.label !== 'string') continue;
        if (!g.url.startsWith('/images/')) continue;
        const fig = document.createElement('figure');
        const img = document.createElement('img');
        img.src = g.url;
        img.alt = g.label;
        img.loading = 'lazy';
        const cap = document.createElement('figcaption');
        cap.textContent = g.label;
        fig.appendChild(img);
        fig.appendChild(cap);
        box.appendChild(fig);
      }
    } catch {
      // Placeholders remain; live overlay is best-effort.
    }
  })();
</script>
