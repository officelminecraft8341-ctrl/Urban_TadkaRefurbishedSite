---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Button from '../components/Button.astro';
import { siteConfig, directionsUrl } from '../config/site.js';

/**
 * Everything below is drawn from the restaurant's own published description of
 * its cooking — the cities it names, the dishes it cites, the spices it lists.
 * The restaurant publishes no founding date, owner biography or awards list, so
 * this page carries none. That history, if the owner wants it told, is the
 * first item on the owner-review checklist, not something to invent here.
 */
const regions = [
  'Lahore',
  'Peshawar',
  'Rawalpindi',
  'Kabul',
  'Amritsar',
  'Multan',
  'Patiala',
];

const spices = [
  'Cumin seed',
  'Cloves',
  'Cinnamon',
  'Green cardamom',
  'Black cardamom',
  'Saffron',
  'Bay leaves',
  'Mustard seeds',
];
---

<MainLayout
  title="About"
  description="About Urban Tadka — a North Indian restaurant in Irving, Texas, serving the food of the undivided Punjab and the wider North Indian kitchen."
  canonicalPath="/about/"
>
  <section class="section">
    <div class="container about-head">
      <div>
        <p class="eyebrow">About</p>
        <h1>A tradition from India</h1>
        <p class="about-head__lede">
          Urban Tadka is a North Indian restaurant in Irving, Texas, cooking the food of the
          undivided Punjab — curries, tandoor breads and biryani, served at lunch and dinner.
        </p>
        <div class="btn-row about-head__actions">
          <Button href="/menu/" variant="primary" iconAfter="arrowRight">
            See the menu
          </Button>
        </div>
      </div>

      <div class="about-head__media">
        <PhotoPlaceholder ratio="4/3" title="Dining room during dinner service — wide" />
      </div>
    </div>
  </section>

  <section class="section section--warm" aria-labelledby="kitchen-heading">
    <div class="container about-grid">
      <div class="prose">
        <SectionHeading
          eyebrow="The menu"
          id="kitchen-heading"
          title="Food from the undivided Punjab"
        />

        <p>
          Urban Tadka describes its menu as the food of the undivided region of Punjab. It names
          the cities whose kitchens, in its own words, formed the “urbanised melting posts of
          different cultures” that the menu draws on:
        </p>

        <ul class="region-list">
          {regions.map((region) => <li>{region}</li>)}
        </ul>

        <p>
          It is from that mix, the restaurant says, that the everyday combination of
          <strong>sarson da saag</strong> and <strong>makki di roti</strong> sits alongside recipes
          it associates with the royal kitchens.
        </p>
      </div>

      <div class="about-grid__media">
        <PhotoPlaceholder ratio="4/5" tone="night" title="Hands tempering whole spices — tadka close-up" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tadka-heading">
    <div class="container about-grid about-grid--reverse">
      <div class="about-grid__media">
        <PhotoPlaceholder ratio="4/5" title="Chef lifting naan from the tandoor" />
      </div>

      <div class="prose">
        <SectionHeading eyebrow="The name" id="tadka-heading" title="What “tadka” means" />

        <p>
          The restaurant explains its own name: <strong>tadka</strong> is the North Indian
          technique of blooming whole spices in hot oil or ghee to bring flavour to a dish.
        </p>

        <p>The spices it names as part of that technique are:</p>

        <ul class="spice-list">
          {spices.map((spice) => <li>{spice}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="art-band">
      <PhotoPlaceholder ratio="16/9" tone="night" title="Full table of dishes — overhead" />
    </div>
  </div>

  <section class="section section--night" aria-labelledby="about-cta">
    <div class="container about-cta">
      <div>
        <h2 id="about-cta">Come and eat</h2>
        <p class="about-cta__lede">
          {siteConfig.business.addressOneLine} · {siteConfig.business.phoneDisplay}
        </p>
      </div>
      <div class="btn-row">
        <Button href="/menu/" variant="on-night" size="lg" iconAfter="arrowRight">
          See the menu
        </Button>
        <Button href={directionsUrl} variant="outline-night" size="lg" icon="navigation" external>
          Directions
        </Button>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-head {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .about-head {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--sp-8);
    }
  }

  .about-head__lede {
    margin-top: var(--sp-4);
    max-width: 48ch;
    font-size: var(--fs-lg);
    color: var(--ink-2);
  }

  .about-head__actions {
    margin-top: var(--sp-6);
  }

  .about-head__media {
    max-width: 32rem;
  }

  .about-grid {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .about-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--sp-8);
    }

    .about-grid--reverse {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  .about-grid__media {
    max-width: 26rem;
  }

  .region-list,
  .spice-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin-top: var(--sp-4);
  }

  .region-list li,
  .spice-list li {
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-xs);
    font-size: var(--fs-sm);
  }

  .region-list li {
    background: var(--brand-gold);
    color: var(--night);
    font-weight: 600;
  }

  .spice-list li {
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
    background: var(--paper);
  }

  /* A full-width art band between the story and the call to action. It carries
     no heading, so it adds nothing to the document outline — but its "photo
     needed" label stays in the accessibility tree, so screen-reader users get
     the same pending-photography information as sighted users. */
  .art-band {
    padding-block: var(--sp-2) var(--sp-7);
  }

  .about-cta {
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .about-cta {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .about-cta__lede {
    margin-top: var(--sp-2);
    color: #ded7cc;
  }
</style>
