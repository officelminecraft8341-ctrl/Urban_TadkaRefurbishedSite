</style>

<script>
  /**
   * Review recording — progressive enhancement.
   *
   * Without JavaScript every record, badge and note on this page is already
   * readable; this script only adds the ability to record a decision and turn
   * the set of decisions into a block of text that can be sent back.
   *
   * State lives in localStorage, on the reviewer's own machine. Nothing is
   * transmitted anywhere, which is why there is no server side to this page.
   */
  const STORAGE_KEY = 'urban-tadka-photo-review-v1';

  const DECISION_LABELS: Record<string, string> = {
    confirm: 'Confirm',
    correct: 'Correct it',
    owner: 'Ask the owner',
  };

  interface ReviewState {
    version: number;
    decisions: Record<string, { decision: string; note: string }>;
  }

  const batchId = document.querySelector<HTMLElement>('[data-batch-id]')?.dataset.batchId ?? '';
  const batchReceived =
    document.querySelector<HTMLElement>('[data-batch-id]')?.dataset.batchReceived ?? '';

  const records = Array.from(document.querySelectorAll<HTMLElement>('[data-record]'));
  const output = document.querySelector<HTMLElement>('[data-review-output]');
  const progress = document.querySelector<HTMLElement>('[data-review-progress]');
  const status = document.querySelector<HTMLElement>('[data-review-status]');

  const total = records.length;

  function readForm(): ReviewState {
    const decisions: ReviewState['decisions'] = {};

    records.forEach((record) => {
      const id = record.dataset.recordId ?? '';
      const checked = record.querySelector<HTMLInputElement>('[data-decision-input]:checked');
      const note = record.querySelector<HTMLTextAreaElement>('[data-note]');

      decisions[id] = {
        decision: checked?.value ?? '',
        note: (note?.value ?? '').trim(),
      };
    });

    return { version: 1, decisions };
  }

  function save(state: ReviewState): void {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // Private browsing and full storage both throw here. The page still works;
      // the answers simply are not remembered across a reload.
      setStatus('Answers could not be saved in this browser — copy the summary before leaving.');
    }
  }

  function load(): ReviewState | null {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as ReviewState;
      return parsed && parsed.version === 1 ? parsed : null;
    } catch {
      return null;
    }
  }

  function setStatus(message: string): void {
    if (status) status.textContent = message;
  }

  function decidedCount(state: ReviewState): number {
    return Object.values(state.decisions).filter((entry) => entry.decision !== '').length;
  }

  /**
   * The shareable artefact.
   *
   * Deliberately plain text: it survives being pasted into an email, a chat
   * message or a document without losing its meaning, and the record IDs make it
   * unambiguous which image each answer refers to.
   */
  function buildSummary(state: ReviewState): string {
    const lines: string[] = [];
    const reviewed = decidedCount(state);

    lines.push(`PHOTOGRAPH REVIEW — batch ${batchId}`);
    lines.push('');
    lines.push(`Batch received: ${batchReceived}`);
    lines.push(`Records reviewed: ${reviewed} of ${total}`);
    lines.push('Reviewer: ');
    lines.push('Date: ');
    lines.push('');
    lines.push('DECISIONS');
    lines.push('');

    records.forEach((record) => {
      const id = record.dataset.recordId ?? '';
      const label = record.dataset.recordLabel ?? '';
      const entry = state.decisions[id];
      const answer = entry?.decision ? DECISION_LABELS[entry.decision] ?? entry.decision : 'not reviewed';

      lines.push(`${id} — ${answer}`);
      lines.push(`  identification: ${label}`);
      lines.push(`  original file:  ${record.dataset.recordFile ?? ''}`);
      if (entry?.note) lines.push(`  note: ${entry.note}`);
      lines.push('');
    });

    const notes = records
      .map((record) => {
        const id = record.dataset.recordId ?? '';
        const note = state.decisions[id]?.note;
        return note ? `- ${id}: ${note}` : null;
      })
      .filter((entry): entry is string => Boolean(entry));

    lines.push('NOTES');
    lines.push(notes.length > 0 ? notes.join('\n') : '- none');
    lines.push('');
    lines.push('OPEN QUESTIONS (answer below each)');
    document.querySelectorAll<HTMLElement>('[data-question]').forEach((question, index) => {
      lines.push(`${index + 1}. ${question.dataset.question ?? ''}`);
      lines.push(`   owner: ${question.dataset.questionOwner ?? ''}`);
      lines.push('   answer: ');
    });
    lines.push('');
    lines.push('Reminder: the photographs in this batch are third-party review images and are not');
    lines.push('licensed for publication. Replace them with authorised photography before launch.');

    return lines.join('\n');
  }

  function render(): void {
    const state = readForm();

    if (output) output.textContent = buildSummary(state);

    if (progress) {
      const reviewed = decidedCount(state);
      progress.textContent =
        reviewed === 0
          ? `No records reviewed yet — ${total} to go.`
          : reviewed === total
            ? `All ${total} records reviewed. Copy the summary below and send it back.`
            : `${reviewed} of ${total} records reviewed — ${total - reviewed} to go.`;
    }

    save(state);
  }

  function restore(state: ReviewState): void {
    records.forEach((record) => {
      const id = record.dataset.recordId ?? '';
      const entry = state.decisions[id];
      if (!entry) return;

      if (entry.decision) {
        const input = record.querySelector<HTMLInputElement>(
          `[data-decision-input][value="${entry.decision}"]`,
        );
        if (input) input.checked = true;
      }

      const note = record.querySelector<HTMLTextAreaElement>('[data-note]');
      if (note && entry.note) note.value = entry.note;
    });
  }

  records.forEach((record) => {
    record.addEventListener('input', render);
    record.addEventListener('change', render);
  });

  document.querySelector('[data-review-copy]')?.addEventListener('click', async () => {
    const text = buildSummary(readForm());

    try {
      await navigator.clipboard.writeText(text);
      setStatus('Copied. Paste it into an email or message to send the review back.');
    } catch {
      // Clipboard access can be refused (permissions, insecure context). Selecting
      // the block means the reviewer can still copy it with the keyboard.
      const selection = window.getSelection();
      if (output && selection) {
        const range = document.createRange();
        range.selectNodeContents(output);
        selection.removeAllRanges();
        selection.addRange(range);
        setStatus('The summary is selected — press Ctrl or Cmd + C to copy it.');
      } else {
        setStatus('Copying is unavailable in this browser; select the summary text by hand.');
      }
    }
  });

  document.querySelector('[data-review-download]')?.addEventListener('click', () => {
    const text = buildSummary(readForm());
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');

    link.href = url;
    link.download = `photograph-review-${batchId || 'batch'}.txt`;

    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);

    setStatus(`Saved as ${link.download}.`);
  });

  document.querySelector('[data-review-reset]')?.addEventListener('click', () => {
    records.forEach((record) => {
      record
        .querySelectorAll<HTMLInputElement>('[data-decision-input]')
        .forEach((input) => (input.checked = false));
      const note = record.querySelector<HTMLTextAreaElement>('[data-note]');
      if (note) note.value = '';
    });

    try {
      window.localStorage.removeItem(STORAGE_KEY);
    } catch {
      // Nothing to do: the form is cleared either way.
    }

    render();
    setStatus('Answers cleared from this browser.');
  });

  const saved = load();
  if (saved) {
    restore(saved);
    setStatus('Your earlier answers were restored from this browser.');
  }
  render();
</script>
